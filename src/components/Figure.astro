---
// One image at its natural aspect (or forced via ratio), optional caption.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption?: string; ratio?: string; fit?: 'cover' | 'contain' }
const { src, alt, caption, ratio, fit = 'cover' } = Astro.props;
---

<figure class:list={['fig', `fig--${fit}`]} style={ratio ? `--ratio:${ratio}` : undefined}>
  <div class="fig__frame">
    <Image src={src} alt={alt} widths={[640, 960, 1400, 2000]} sizes="(min-width: 1280px) 1200px, 100vw" />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig { margin: 0; }
  .fig__frame { aspect-ratio: var(--ratio, auto); overflow: hidden; border-radius: var(--radius); background: var(--c-tile); }
  .fig__frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fig--contain .fig__frame img { object-fit: contain; }
  figcaption { font-size: var(--fs-s); color: var(--c-ink-soft); margin-top: 0.75rem; max-width: var(--measure); }
</style>
