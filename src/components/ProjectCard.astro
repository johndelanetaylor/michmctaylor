---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { tagLabel } from '../lib/tags';
import { url } from '../lib/site';

interface Props { project: CollectionEntry<'work'>; loading?: 'lazy' | 'eager'; compact?: boolean }
const { project, loading = 'lazy', compact = false } = Astro.props;
const { title, hero, heroAlt, card, tags } = project.data;
---

<a class:list={['card', { 'card--compact': compact }]} href={url(`/work/${project.id}/`)}>
  <div class="card__media">
    <Image src={card ?? hero} alt={card ? '' : heroAlt} width={900} height={900} loading={loading} />
  </div>
  <div class="card__body">
    <h3 class="card__title">{title}</h3>
    {!compact && <p class="card__meta">{tags.map(tagLabel).join(' · ')}</p>}
  </div>
</a>

<style>
  .card { display: block; position: relative; text-decoration: none; color: inherit; }
  .card__media { aspect-ratio: 1; overflow: hidden; border-radius: var(--radius); background: var(--c-line); }
  .card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .card:hover .card__media img { transform: scale(1.03); }
  .card__body { padding-top: 0.75rem; }
  .card__title { font-size: var(--fs-3); margin: 0; }
  .card:hover .card__title { color: var(--c-accent); }
  .card__meta { font-size: var(--fs-s); color: var(--c-ink-soft); margin: 0.25rem 0 0; }

  /* compact: image only, title slides in on hover/focus */
  .card--compact .card__body {
    position: absolute; inset: auto 0 0 0; padding: 2rem 1rem 1rem;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.65));
    color: #fff; border-radius: 0 0 var(--radius) var(--radius);
    opacity: 0; transition: opacity 0.2s;
  }
  .card--compact:hover .card__body, .card--compact:focus-visible .card__body { opacity: 1; }
  .card--compact .card__title, .card--compact:hover .card__title { color: #fff; font-size: var(--fs-4); }
  @media (prefers-reduced-motion: reduce) { .card__media img, .card__body { transition: none; } }
</style>
