---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectGrid from '../../../components/ProjectGrid.astro';
import { tagKeys, tagLabel, type Tag } from '../../../lib/tags';
import { url } from '../../../lib/site';

export function getStaticPaths() {
  return tagKeys.map((tag) => ({ params: { tag } }));
}
const tag = Astro.params.tag as Tag;
const label = tagLabel(tag);
---

<BaseLayout title={`${label} work`} description={`${label} projects by Michelle M. Taylor.`}>
  <section class="section wrap">
    <h1>{label}</h1>
    <nav class="chips" aria-label="Filter by discipline">
      <a class="chip" href={url("/work/")}>All</a>
      {tagKeys.map((t) => <a class="chip" href={url(`/work/tag/${t}/`)} aria-current={t === tag ? 'page' : undefined}>{tagLabel(t)}</a>)}
    </nav>
  </section>
  <section class="wrap">
    <ProjectGrid tag={tag} />
  </section>
</BaseLayout>

<style>
  h1 { margin-bottom: 1.5rem; }
</style>
