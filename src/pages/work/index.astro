---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import { tagKeys, tagLabel } from '../../lib/tags';
import { url } from '../../lib/site';
---

<BaseLayout title="Work" description="Selected branding, packaging, motion, and content work by Michelle M. Taylor.">
  <section class="section wrap">
    <h1>work</h1>
    <nav class="chips" aria-label="Filter by discipline">
      <a class="chip" href={url("/work/")} aria-current="page">All</a>
      {tagKeys.map((t) => <a class="chip" href={url(`/work/tag/${t}/`)}>{tagLabel(t)}</a>)}
    </nav>
  </section>
  <section class="wrap">
    <ProjectGrid />
  </section>
</BaseLayout>

<style>
  h1 { margin-bottom: 1.5rem; }
</style>
