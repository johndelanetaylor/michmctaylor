---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import { tagLabel } from '../../lib/tags';
import { url } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getCollection('work', ({ data }) => !data.draft);
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const { title, client, summary, year, tags, services, hero, heroAlt } = project.data;

// "More work": other projects sharing a tag, max 3.
const related = (
  await getCollection('work', ({ id, data }) => !data.draft && id !== project.id && data.tags.some((t) => tags.includes(t)))
)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout title={title} description={summary} ogImage={hero.src}>
  <article>
    <header class="section wrap">
      <p class="eyebrow">{client}{year && ` · ${year}`}</p>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
    </header>

    <div class="wrap">
      <div class="hero">
        <Image src={hero} alt={heroAlt} widths={[800, 1280, 2000]} sizes="(min-width: 1280px) 1280px, 100vw" loading="eager" fetchpriority="high" />
      </div>
      <dl class="meta">
        <div><dt>Client</dt><dd>{client}</dd></div>
        {year && <div><dt>Year</dt><dd>{year}</dd></div>}
        {services.length > 0 && <div><dt>Services</dt><dd>{services.join(', ')}</dd></div>}
        <div>
          <dt>Disciplines</dt>
          <dd class="chips">{tags.map((t) => <a class="chip" href={url(`/work/tag/${t}/`)}>{tagLabel(t)}</a>)}</dd>
        </div>
      </dl>
    </div>

    <div class="wrap prose section">
      <Content />
    </div>
  </article>

  {related.length > 0 && (
    <aside class="wrap section">
      <h2>more work</h2>
      <ProjectGrid projects={related} />
    </aside>
  )}
</BaseLayout>

<style>
  header.section { padding-bottom: clamp(1.5rem, 4vw, 3rem); }
  header h1 { margin-bottom: 0.4em; }
  .hero { aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius); background: var(--c-tile); }
  .hero img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (max-width: 640px) { .hero { aspect-ratio: 4 / 3; } }
  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1.5rem 2rem; margin: 1.5rem 0 0; padding-top: 1.5rem; border-top: 1px solid var(--c-line); }
  .meta dt { font-size: var(--fs-s); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-ink-soft); margin-bottom: 0.35rem; }
  .meta dd { margin: 0; }
  .meta .chips { gap: 0.4rem; }
  .prose.section { padding-top: clamp(2rem, 5vw, 4rem); }
</style>
