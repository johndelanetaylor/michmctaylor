---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/site';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout title="Blog" description="Graphic design insights, resources, and creative delights from Michelle M. Taylor.">
  <section class="section wrap">
    <h1>blog</h1>
    <ul role="list" class="posts">
      {posts.map((p) => (
        <li>
          <a href={url(`/blog/${p.id}/`)}>
            <time datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .posts { display: grid; gap: 2rem; max-width: 48rem; }
  .posts a { display: block; text-decoration: none; color: inherit; padding-bottom: 2rem; border-bottom: 1px solid var(--c-line); }
  .posts h2 { font-size: var(--fs-3); margin: 0.25rem 0 0.5rem; }
  .posts a:hover h2 { color: var(--c-accent); }
  .posts time { font-size: var(--fs-s); color: var(--c-ink-soft); }
  .posts p { margin: 0; }
</style>
